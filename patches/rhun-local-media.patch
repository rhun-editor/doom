+    call extview_evbuf
+    mov rdi, rax
+    lea rsi, [rip + .Le_key_up]
+    call sb_push_cstr
+    call extview_evbuf
+    mov rdi, rax
+    mov esi, r13d
+    call viewpic_push_mods
+    call extview_evbuf
+    mov rdi, rax
+    mov esi, ' '
+    call sb_push_byte
+    call extview_evbuf
+    mov rdi, rax
+    mov rsi, r14
+    call sb_push_cstr
+    mov rdi, rbx
+    call extview_event_send
+9:  EPILOGUE
+
+FN viewpic_modifiers
+    PROLOGUE
+    mov r12d, edi
+    call views_focused_picture
+    mov rbx, rax
+    mov rdi, rax
+    call keys_on
+    test eax, eax
+    jz 9f
+    mov rcx, [rbx + VW_ext]
+    FEAT_TEST rcx, FEAT_VIEW_KEY_STATE
+    jz 9f
+    mov rdi, rbx
+    call extview_event_head
+    test eax, eax
+    jz 9f
+    call extview_evbuf
+    mov rdi, rax
+    lea rsi, [rip + .Le_modifiers]
+    call sb_push_cstr
+    call extview_evbuf
+    mov rdi, rax
+    mov esi, r12d
+    call viewpic_push_mods
+    mov rdi, rbx
+    call extview_event_send
+9:  EPILOGUE
+
+FN viewpic_window_focus
+    PROLOGUE
+    mov r12d, edi
+    call views_focused_picture
+    test rax, rax
+    jz 9f
+    mov rbx, rax
