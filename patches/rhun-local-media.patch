+// Paired releases for extension pictures that negotiated view-key-state.
+v_keyUp:
+    IMP
+    mov x19, x2
+    mov x0, x19
+    MSG modifierFlags
+    bl ns_mods
+    mov w20, w0
+    mov x0, x19
+    MSG keyCode
+    and w21, w0, #0xffff
+    cmp w21, #128
+    b.hs 2f
+    ADR x9, special_keys
+    ldr w22, [x9, w21, uxtw #2]
+    cbnz w22, 3f
+2:  mov w0, w21
+    mov w1, #0
+    bl ascii_key
+    mov w22, w0
+3:  cbz w22, 4f
+    mov w0, w22
+    mov w1, w20
+    XCALL viewpic_key_up
+4:  IMPRET
+
+v_flagsChanged:
+    IMP
+    mov x0, x2
+    MSG modifierFlags
+    bl ns_mods
+    XCALL viewpic_modifiers
+    IMPRET
+
